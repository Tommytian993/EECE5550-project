<?xml version="1.0"?>
<sdf version="1.10">
  <model name="orchard_robot">
      <static>false</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>4</mass>
        <inertia>
          <ixx>0.0641333333</ixx>
          <iyy>0.1308</iyy>
          <izz>0.1733333333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.18</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.55 0.2 1</ambient>
          <diffuse>0.15 0.55 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="left_wheel">
      <pose>0 0.25 0.12 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <iyy>0.00117</iyy>
          <izz>0.00216</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.25 0.12 1.57079632679 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00117</ixx>
          <iyy>0.00117</iyy>
          <izz>0.00216</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>10</effort>
          <velocity>30</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>10</effort>
          <velocity>30</velocity>
        </limit>
      </axis>
    </joint>

    <link name="caster">
      <pose>-0.23 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
      <pose relative_to="caster">0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
