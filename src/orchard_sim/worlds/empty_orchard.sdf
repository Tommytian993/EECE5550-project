<?xml version="1.0"?>
<sdf version="1.10">
  <world name="orchard">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
    </scene>

    <include>
      <uri>model://ground</uri>
    </include>

    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_01</name>
      <pose>2 2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_02</name>
      <pose>5 2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_03</name>
      <pose>8 2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_04</name>
      <pose>2 -2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_05</name>
      <pose>5 -2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://tree_trunk</uri>
      <name>tree_06</name>
      <pose>8 -2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://orchard_robot</uri>
    </include>
  </world>
</sdf>
