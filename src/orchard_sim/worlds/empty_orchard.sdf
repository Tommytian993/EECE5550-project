<?xml version="1.0"?>
<sdf version="1.10">
  <world name="orchard">
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
    </scene>

    <!-- 引入地面；通过模型搜索目录查找。 -->
    <include>
      <uri>model://ground</uri>
    </include>
    <!-- 引入方块障碍物；通过模型搜索目录查找。 -->
    <include>
      <uri>model://obstacle_0</uri>
    </include>

    <!-- 引入小车（车身、车轮、关节和支撑球）；通过模型搜索目录查找。 -->
    <include>
      <uri>model://orchard_robot</uri>
    </include>
  </world>
</sdf>
